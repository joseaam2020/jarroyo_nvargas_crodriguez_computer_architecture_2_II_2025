import fixed_point_pkg::*;

module bilinear_downscaler_top #(
    parameter ADDR_WIDTH = 18,
    parameter DATA_WIDTH = 8,
    parameter MEM_SIZE   = 262144,
    parameter MAX_SIMD_WIDTH = 8,
    parameter CTRL_ADDR_WIDTH = 8
)(
    input  logic        clk,
    input  logic        rst_n,

    input  logic [CTRL_ADDR_WIDTH-1:0] ctrl_addr,
    input  logic        ctrl_wr_en,
    input  logic        ctrl_rd_en,
    input  logic [31:0] ctrl_wr_data,
    output logic [31:0] ctrl_rd_data,

    output logic        processing_active,
    output logic        processing_complete
);

    logic [9:0]  img_width;
    logic [9:0]  img_height;
    fixed_point_t scale_factor;
    logic        mode_simd;
    logic [2:0]  simd_width;
    logic        start;
    logic        step_mode;
    logic        step_next;

    logic        busy;
    logic        ready;
    logic        error;
    logic [31:0] progress;
    logic [31:0] flops_count;
    logic [31:0] mem_reads;
    logic [31:0] mem_writes;

    logic        addr_gen_start;
    logic        addr_gen_next;
    logic        addr_gen_valid;
    logic        addr_gen_done;

    logic [17:0] addr_tl, addr_tr, addr_bl, addr_br;
    fixed_point_t weight_x, weight_y;

    logic [7:0]  pixel_tl, pixel_tr, pixel_bl, pixel_br;

    logic        interpolate_start;
    logic        interpolate_done;
    logic        interpolate_valid_in;
    logic        interpolate_valid_out;
    logic [7:0]  interpolate_result;

    logic        result_write_en;
    logic [17:0] result_write_addr;

    logic [17:0] src_mem_rd_addr;
    logic [7:0]  src_mem_rd_data;
    logic [17:0] dst_mem_wr_addr;
    logic        dst_mem_wr_en;
    logic [7:0]  dst_mem_wr_data;

    logic        perf_clear;
    logic        perf_flop_inc;
    logic [31:0] perf_flop_count;
    logic        perf_mem_read_inc;
    logic        perf_mem_write_inc;

    logic [9:0]  pixel_counter_x;
    logic [9:0]  pixel_counter_y;
    logic [19:0] total_pixels;

    logic [2:0]  fetch_state;
    localparam FETCH_IDLE = 3'd0;
    localparam FETCH_TL   = 3'd1;
    localparam FETCH_TR   = 3'd2;
    localparam FETCH_BL   = 3'd3;
    localparam FETCH_BR   = 3'd4;
    localparam FETCH_DONE = 3'd5;

    logic [7:0]  pixel_tl_reg, pixel_tr_reg, pixel_bl_reg, pixel_br_reg;

    control_registers #(
        .ADDR_WIDTH(CTRL_ADDR_WIDTH)
    ) ctrl_regs_inst (
        .clk(clk),
        .rst_n(rst_n),
        .addr(ctrl_addr),
        .wr_en(ctrl_wr_en),
        .rd_en(ctrl_rd_en),
        .wr_data(ctrl_wr_data),
        .rd_data(ctrl_rd_data),
        .img_width(img_width),
        .img_height(img_height),
        .scale_factor(scale_factor),
        .mode_simd(mode_simd),
        .simd_width(simd_width),
        .start(start),
        .step_mode(step_mode),
        .step_next(step_next),
        .busy(busy),
        .ready(ready),
        .error(error),
        .progress(progress),
        .flops_count(flops_count),
        .mem_reads(mem_reads),
        .mem_writes(mem_writes)
    );

    downscaler_fsm fsm_inst (
        .clk(clk),
        .rst_n(rst_n),
        .start(start),
        .step_mode(step_mode),
        .step_next(step_next),
        .addr_gen_done(addr_gen_done),
        .addr_gen_start(addr_gen_start),
        .addr_gen_next(addr_gen_next),
        .interpolate_start(interpolate_start),
        .interpolate_done(interpolate_done),
        .result_write_en(result_write_en),
        .busy(busy),
        .ready(ready),
        .error(error)
    );

    address_generator addr_gen_inst (
        .clk(clk),
        .rst_n(rst_n),
        .start(addr_gen_start),
        .next_pixel(addr_gen_next),
        .src_width(img_width),
        .src_height(img_height),
        .scale_factor(scale_factor),
        .addr_tl(addr_tl),
        .addr_tr(addr_tr),
        .addr_bl(addr_bl),
        .addr_br(addr_br),
        .weight_x(weight_x),
        .weight_y(weight_y),
        .valid(addr_gen_valid),
        .done(addr_gen_done)
    );

    image_memory #(
        .ADDR_WIDTH(ADDR_WIDTH),
        .DATA_WIDTH(DATA_WIDTH),
        .MEM_SIZE(MEM_SIZE)
    ) src_memory (
        .clk(clk),
        .rd_addr(src_mem_rd_addr),
        .rd_data(src_mem_rd_data),
        .wr_addr(18'h0),
        .wr_en(1'b0),
        .wr_data(8'h0)
    );

    image_memory #(
        .ADDR_WIDTH(ADDR_WIDTH),
        .DATA_WIDTH(DATA_WIDTH),
        .MEM_SIZE(MEM_SIZE)
    ) dst_memory (
        .clk(clk),
        .rd_addr(18'h0),
        .rd_data(),
        .wr_addr(dst_mem_wr_addr),
        .wr_en(dst_mem_wr_en),
        .wr_data(dst_mem_wr_data)
    );

    always_ff @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            fetch_state <= FETCH_IDLE;
            pixel_tl_reg <= 8'h0;
            pixel_tr_reg <= 8'h0;
            pixel_bl_reg <= 8'h0;
            pixel_br_reg <= 8'h0;
            interpolate_valid_in <= 1'b0;
            perf_mem_read_inc <= 1'b0;
        end else begin
            perf_mem_read_inc <= 1'b0;
            interpolate_valid_in <= 1'b0;

            case (fetch_state)
                FETCH_IDLE: begin
                    if (addr_gen_valid && interpolate_start) begin
                        src_mem_rd_addr <= addr_tl;
                        fetch_state <= FETCH_TL;
                        perf_mem_read_inc <= 1'b1;
                    end
                end

                FETCH_TL: begin
                    pixel_tl_reg <= src_mem_rd_data;
                    src_mem_rd_addr <= addr_tr;
                    fetch_state <= FETCH_TR;
                    perf_mem_read_inc <= 1'b1;
                end

                FETCH_TR: begin
                    pixel_tr_reg <= src_mem_rd_data;
                    src_mem_rd_addr <= addr_bl;
                    fetch_state <= FETCH_BL;
                    perf_mem_read_inc <= 1'b1;
                end

                FETCH_BL: begin
                    pixel_bl_reg <= src_mem_rd_data;
                    src_mem_rd_addr <= addr_br;
                    fetch_state <= FETCH_BR;
                    perf_mem_read_inc <= 1'b1;
                end

                FETCH_BR: begin
                    pixel_br_reg <= src_mem_rd_data;
                    interpolate_valid_in <= 1'b1;
                    fetch_state <= FETCH_DONE;
                end

                FETCH_DONE: begin
                    fetch_state <= FETCH_IDLE;
                end

                default: begin
                    fetch_state <= FETCH_IDLE;
                end
            endcase
        end
    end

    assign pixel_tl = pixel_tl_reg;
    assign pixel_tr = pixel_tr_reg;
    assign pixel_bl = pixel_bl_reg;
    assign pixel_br = pixel_br_reg;

    bilinear_interpolator interp_inst (
        .clk(clk),
        .rst_n(rst_n),
        .valid_in(interpolate_valid_in),
        .pixel_tl(pixel_tl),
        .pixel_tr(pixel_tr),
        .pixel_bl(pixel_bl),
        .pixel_br(pixel_br),
        .weight_x(weight_x),
        .weight_y(weight_y),
        .valid_out(interpolate_valid_out),
        .pixel_out(interpolate_result)
    );

    assign interpolate_done = interpolate_valid_out;

    always_ff @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            result_write_addr <= 18'h0;
            pixel_counter_x <= 10'h0;
            pixel_counter_y <= 10'h0;
        end else begin
            if (start) begin
                result_write_addr <= 18'h0;
                pixel_counter_x <= 10'h0;
                pixel_counter_y <= 10'h0;
            end else if (result_write_en && interpolate_valid_out) begin
                result_write_addr <= result_write_addr + 1;

                if (pixel_counter_x >= ((img_width * scale_factor) >> 8) - 1) begin
                    pixel_counter_x <= 10'h0;
                    pixel_counter_y <= pixel_counter_y + 1;
                end else begin
                    pixel_counter_x <= pixel_counter_x + 1;
                end
            end
        end
    end

    assign dst_mem_wr_addr = result_write_addr;
    assign dst_mem_wr_en = result_write_en && interpolate_valid_out;
    assign dst_mem_wr_data = interpolate_result;

    always_ff @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            perf_mem_write_inc <= 1'b0;
        end else begin
            perf_mem_write_inc <= dst_mem_wr_en;
        end
    end

    assign perf_clear = start;
    assign perf_flop_inc = interpolate_valid_in;
    assign perf_flop_count = 32'd16;

    performance_counters perf_counters_inst (
        .clk(clk),
        .rst_n(rst_n),
        .clear(perf_clear),
        .flop_inc(perf_flop_inc),
        .flop_count(perf_flop_count),
        .mem_read_inc(perf_mem_read_inc),
        .mem_write_inc(perf_mem_write_inc),
        .total_flops(flops_count),
        .total_mem_reads(mem_reads),
        .total_mem_writes(mem_writes)
    );

    always_comb begin
        logic [19:0] dst_w, dst_h;
        dst_w = (img_width * scale_factor) >> 8;
        dst_h = (img_height * scale_factor) >> 8;
        total_pixels = dst_w * dst_h;

        if (total_pixels != 0) begin
            progress = ((pixel_counter_y * dst_w + pixel_counter_x) * 100) / total_pixels;
        end else begin
            progress = 32'h0;
        end
    end

    assign processing_active = busy;
    assign processing_complete = ready && !busy;

endmodule