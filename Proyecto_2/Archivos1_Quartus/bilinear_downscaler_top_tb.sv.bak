`timescale 1ns / 1ps

import fixed_point_pkg::*;

module bilinear_downscaler_top_tb;

    // Señales del DUT
    logic        clk;
    logic        rst_n;

    logic [7:0]  ctrl_addr;
    logic        ctrl_wr_en;
    logic        ctrl_rd_en;
    logic [31:0] ctrl_wr_data;
    logic [31:0] ctrl_rd_data;

    logic        processing_active;
    logic        processing_complete;

    // Variables internas del testbench
    logic [31:0] read_val;
    integer      step_count;

    // Instancia del DUT
    bilinear_downscaler_top dut (
        .clk(clk),
        .rst_n(rst_n),
        .ctrl_addr(ctrl_addr),
        .ctrl_wr_en(ctrl_wr_en),
        .ctrl_rd_en(ctrl_rd_en),
        .ctrl_wr_data(ctrl_wr_data),
        .ctrl_rd_data(ctrl_rd_data),
        .processing_active(processing_active),
        .processing_complete(processing_complete)
    );

    // Generador de reloj
    initial begin
        clk = 1'b0;
        forever #5 clk = ~clk;
    end

    // Task para resetear el sistema
    task reset_system();
        begin
            rst_n = 1'b0;
            ctrl_wr_en = 1'b0;
            ctrl_rd_en = 1'b0;
            ctrl_addr = 8'h0;
            ctrl_wr_data = 32'h0;
            repeat(5) @(posedge clk);
            rst_n = 1'b1;
            repeat(2) @(posedge clk);
        end
    endtask

    // Task para escribir un registro
    task write_register(input logic [7:0] addr, input logic [31:0] data);
        begin
            @(posedge clk);
            ctrl_addr = addr;
            ctrl_wr_data = data;
            ctrl_wr_en = 1'b1;
            @(posedge clk);
            ctrl_wr_en = 1'b0;
        end
    endtask

    // Task para leer un registro
    task read_register(input logic [7:0] addr, output logic [31:0] data);
        begin
            @(posedge clk);
            ctrl_addr = addr;
            ctrl_rd_en = 1'b1;
            @(posedge clk);
            data = ctrl_rd_data;
            ctrl_rd_en = 1'b0;
        end
    endtask

    // Task para esperar a que termine el procesamiento
    task wait_for_completion(input integer timeout_cycles);
        integer cycle_count;
        begin
            cycle_count = 0;
            while (processing_active && cycle_count < timeout_cycles) begin
                @(posedge clk);
                cycle_count = cycle_count + 1;
            end

            if (cycle_count >= timeout_cycles) begin
                $display("[ERROR] Timeout waiting for processing to complete after %0d cycles", timeout_cycles);
            end else begin
                $display("[INFO] Processing completed after %0d cycles", cycle_count);
            end
        end
    endtask

    // Bloque principal de pruebas
    initial begin
        $display("========================================");
        $display("Bilinear Downscaler FPGA Testbench");
        $display("========================================");
        $display("");

        step_count = 0;
        read_val = 0;

        reset_system();
        $display("[TEST 1] System Reset - PASSED");
        $display("");

        write_register(8'h00, 16'd512);
        write_register(8'h01, 16'd512);
        $display("[TEST 2] Configure Image Dimensions: 512x512");
        $display("");

        write_register(8'h02, 16'h0080);
        $display("[TEST 3] Configure Scale Factor: 0x0080 (0.5x downscale)");
        $display("");

        read_register(8'h00, read_val);
        $display("[VERIFY] Read Image Width: %0d", read_val[9:0]);

        read_register(8'h01, read_val);
        $display("[VERIFY] Read Image Height: %0d", read_val[9:0]);

        read_register(8'h02, read_val);
        $display("[VERIFY] Read Scale Factor: 0x%04h", read_val[15:0]);
        $display("");

        write_register(8'h03, 32'h00000000);
        $display("[TEST 4] Set Mode: Sequential (1 pixel/cycle)");
        $display("");

        write_register(8'h04, 32'h00000001);
        $display("[TEST 5] Start Processing");
        $display("");

        wait_for_completion(100000);
        $display("");

        read_register(8'h05, read_val);
        $display("[STATUS] Status Register: 0x%08h", read_val);
        $display("  - Ready: %b", read_val[0]);
        $display("  - Busy: %b", read_val[1]);
        $display("  - Error: %b", read_val[2]);
        $display("");

        read_register(8'h06, read_val);
        $display("[METRICS] Progress: %0d%%", read_val);

        read_register(8'h07, read_val);
        $display("[METRICS] Total FLOPs: %0d", read_val);

        read_register(8'h08, read_val);
        $display("[METRICS] Memory Reads: %0d", read_val);

        read_register(8'h09, read_val);
        $display("[METRICS] Memory Writes: %0d", read_val);
        $display("");

        $display("[TEST 6] Sequential Mode - Completed");
        $display("");

        repeat(10) @(posedge clk);

        reset_system();
        $display("[TEST 7] System Reset for Mode 2");
        $display("");

        write_register(8'h00, 16'd256);
        write_register(8'h01, 16'd256);
        write_register(8'h02, 16'h0100);
        $display("[TEST 8] Configure: 256x256 image, Scale 1.0x");
        $display("");

        write_register(8'h03, 32'h00000005);
        $display("[TEST 9] Set Mode: SIMD (4 pixels/cycle)");
        $display("");

        write_register(8'h04, 32'h00000001);
        $display("[TEST 10] Start Processing with SIMD");
        $display("");

        wait_for_completion(50000);
        $display("");

        read_register(8'h07, read_val);
        $display("[METRICS] Total FLOPs: %0d", read_val);

        read_register(8'h08, read_val);
        $display("[METRICS] Memory Reads: %0d", read_val);

        read_register(8'h09, read_val);
        $display("[METRICS] Memory Writes: %0d", read_val);
        $display("");

        $display("[TEST 11] SIMD Mode - Completed");
        $display("");

        repeat(10) @(posedge clk);

        reset_system();
        $display("[TEST 12] Test Step Mode");
        $display("");

        write_register(8'h00, 16'd64);
        write_register(8'h01, 16'd64);
        write_register(8'h02, 16'h0200);
        $display("[TEST 13] Configure: 64x64 image, Scale 2.0x");
        $display("");

        write_register(8'h04, 32'h00000003);
        $display("[TEST 14] Enable Step Mode (bit[1]=1)");
        $display("");

        write_register(8'h04, 32'h00000001);
        $display("[TEST 15] Start Processing");
        $display("");

        repeat(100) @(posedge clk);

        step_count = 0;
        repeat(20) begin
            write_register(8'h04, 32'h00000100);
            $display("[STEP %0d] Advance one pixel", step_count);
            repeat(50) @(posedge clk);
            step_count = step_count + 1;
        end
        $display("");

        $display("[TEST 16] Step Mode - Completed");
        $display("");

        $display("========================================");
        $display("All Tests Completed Successfully");
        $display("========================================");

        $finish;
    end

    // Monitoreo de señal de procesamiento completo
    always @(posedge clk) begin
        if (processing_complete) begin
            $display("[INFO @ %0t ns] Processing Complete Signal Asserted", $time);
        end
    end

endmodule
