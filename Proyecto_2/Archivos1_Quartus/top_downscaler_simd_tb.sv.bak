// tb_top_downscaler_simd.sv
// Testbench para top_downscaler_simd
// Prueba la implementación SIMD del downscaler con interpolación bilineal

`timescale 1ns/1ps
import fixed_point_pkg::*;

module tb_top_downscaler_simd;

  // =====================================================================
  // Parámetros
  // =====================================================================
  localparam int SIMD_WIDTH = 8;
  localparam int ADDR_WIDTH = 18;
  localparam int COORD_WIDTH = 10;
  localparam int REG_ADDR_WIDTH = 8;
  localparam int MEM_SIZE = 262144;
  localparam int CLK_PERIOD = 10;  // 10 ns = 100 MHz

  // =====================================================================
  // Señales
  // =====================================================================
  logic                         clk;
  logic                         rst_n;

  logic [REG_ADDR_WIDTH-1:0]    reg_addr;
  logic                         reg_wr_en;
  logic                         reg_rd_en;
  logic [31:0]                  reg_wr_data;
  logic [31:0]                  reg_rd_data;

  logic [ADDR_WIDTH-1:0]        mem_wr_addr;
  logic                         mem_wr_en;
  logic [SIMD_WIDTH*8-1:0]      mem_wr_data;

  logic                         ready;
  logic                         busy;
  logic                         error;

  // =====================================================================
  // Instancia del DUT (Device Under Test)
  // =====================================================================
  top_downscaler_simd #(
    .SIMD_WIDTH(SIMD_WIDTH),
    .ADDR_WIDTH(ADDR_WIDTH),
    .COORD_WIDTH(COORD_WIDTH),
    .REG_ADDR_WIDTH(REG_ADDR_WIDTH),
    .MEM_SIZE(MEM_SIZE)
  ) dut (
    .clk(clk),
    .rst_n(rst_n),
    .reg_addr(reg_addr),
    .reg_wr_en(reg_wr_en),
    .reg_rd_en(reg_rd_en),
    .reg_wr_data(reg_wr_data),
    .reg_rd_data(reg_rd_data),
    .mem_wr_addr(mem_wr_addr),
    .mem_wr_en(mem_wr_en),
    .mem_wr_data(mem_wr_data),
    .ready(ready),
    .busy(busy),
    .error(error)
  );

  // =====================================================================
  // Generador de reloj
  // =====================================================================
  initial begin
    clk = 1'b0;
    forever #(CLK_PERIOD/2) clk = ~clk;
  end

  // =====================================================================
  // Reset
  // =====================================================================
  initial begin
    rst_n = 1'b0;
    #(2 * CLK_PERIOD);
    rst_n = 1'b1;
  end

  // =====================================================================
  // Tareas auxiliares para acceso a registros
  // =====================================================================

  // Escritura en registro
  task automatic write_register(
    input logic [REG_ADDR_WIDTH-1:0] addr,
    input logic [31:0] data
  );
    @(posedge clk);
    reg_addr = addr;
    reg_wr_en = 1'b1;
    reg_wr_data = data;
    @(posedge clk);
    reg_wr_en = 1'b0;
    @(posedge clk);
  endtask

  // Lectura de registro
  task automatic read_register(
    input logic [REG_ADDR_WIDTH-1:0] addr,
    output logic [31:0] data
  );
    @(posedge clk);
    reg_addr = addr;
    reg_rd_en = 1'b1;
    @(posedge clk);
    data = reg_rd_data;
    reg_rd_en = 1'b0;
    @(posedge clk);
  endtask

  // =====================================================================
  // Testbench principal
  // =====================================================================
  initial begin
    $display("========================================");
    $display("Testbench: top_downscaler_simd (SIMD_WIDTH=%0d)", SIMD_WIDTH);
    $display("========================================");
    $display("[%0t] Iniciando test...", $time);

    // Inicialización
    reg_addr = '0;
    reg_wr_en = 1'b0;
    reg_rd_en = 1'b0;
    reg_wr_data = '0;

    // Esperar a que el reset se complete
    wait(rst_n == 1'b1);
    #(5 * CLK_PERIOD);

    $display("[%0t] Reset completado. Sistema listo.", $time);

    // ===== TEST 1: Lectura de estado inicial =====
    $display("\n=== TEST 1: Estado inicial ===");
    read_register(8'h05, reg_rd_data);  // ADDR_STATUS
    $display("[%0t] Status register: 0x%08h (ready=%b, busy=%b, error=%b)",
      $time, reg_rd_data, reg_rd_data[0], reg_rd_data[1], reg_rd_data[2]);

    // ===== TEST 2: Configuración básica =====
    $display("\n=== TEST 2: Configuración de registros ===");
    
    // Configurar dimensiones
    $display("[%0t] Escribiendo ancho de imagen (512 píxeles)...", $time);
    write_register(8'h00, 32'd512);   // ADDR_IMG_WIDTH
    
    $display("[%0t] Escribiendo alto de imagen (512 píxeles)...", $time);
    write_register(8'h01, 32'd512);   // ADDR_IMG_HEIGHT
    
    $display("[%0t] Escribiendo factor de escala (1.0x = 0x0100)...", $time);
    write_register(8'h02, 32'h0100);  // ADDR_SCALE_FACTOR (1.0 en fixed point)
    
    // Configurar modo SIMD
    $display("[%0t] Escribiendo modo SIMD (SIMD_WIDTH = 8)...", $time);
    write_register(8'h03, 32'd8);     // ADDR_MODE (simd_width = 8)

    // ===== TEST 3: Lectura de configuración =====
    $display("\n=== TEST 3: Verificación de configuración ===");
    read_register(8'h00, reg_rd_data);
    $display("[%0t] IMG_WIDTH: 0x%08h (esperado: 0x00000200)", $time, reg_rd_data);
    
    read_register(8'h01, reg_rd_data);
    $display("[%0t] IMG_HEIGHT: 0x%08h (esperado: 0x00000200)", $time, reg_rd_data);
    
    read_register(8'h02, reg_rd_data);
    $display("[%0t] SCALE_FACTOR: 0x%08h (esperado: 0x00000100)", $time, reg_rd_data);
    
    read_register(8'h03, reg_rd_data);
    $display("[%0t] MODE: 0x%08h (simd_width=%0d)", $time, reg_rd_data, reg_rd_data[2:0]);

    // ===== TEST 4: Iniciar procesamiento =====
    $display("\n=== TEST 4: Iniciando procesamiento ===");
    $display("[%0t] Escribiendo comando START...", $time);
    write_register(8'h04, 32'h0001);  // ADDR_CONTROL, start=1

    // Esperar a que comience
    #(5 * CLK_PERIOD);

    // ===== TEST 5: Monitoreo de estado =====
    $display("\n=== TEST 5: Monitoreo durante procesamiento ===");
    for (int i = 0; i < 20; i++) begin
      read_register(8'h05, reg_rd_data);  // ADDR_STATUS
      read_register(8'h06, reg_rd_data);  // ADDR_PROGRESS
      $display("[%0t] Ciclo %0d: Progress=%0d, Ready=%b, Busy=%b",
        $time, i, reg_rd_data, ready, busy);
      
      if (!busy && ready) begin
        $display("[%0t] ✓ Procesamiento completado!", $time);
        break;
      end
      #(10 * CLK_PERIOD);
    end

    // ===== TEST 6: Lectura de contadores de rendimiento =====
    $display("\n=== TEST 6: Contadores de rendimiento ===");
    read_register(8'h07, reg_rd_data);
    $display("[%0t] Total FLOPs: %0d", $time, reg_rd_data);
    
    read_register(8'h08, reg_rd_data);
    $display("[%0t] Memory Reads: %0d", $time, reg_rd_data);
    
    read_register(8'h09, reg_rd_data);
    $display("[%0t] Memory Writes: %0d", $time, reg_rd_data);

    // ===== TEST 7: Test con factor de escala diferente =====
    $display("\n=== TEST 7: Test con escala 0.5x ===");
    $display("[%0t] Escribiendo factor de escala (0.5x = 0x0080)...", $time);
    write_register(8'h02, 32'h0080);  // SCALE_FACTOR = 0.5x

    read_register(8'h02, reg_rd_data);
    $display("[%0t] SCALE_FACTOR leído: 0x%08h", $time, reg_rd_data);

    // ===== TEST 8: Modo STEP-BY-STEP =====
    $display("\n=== TEST 8: Modo STEP-BY-STEP ===");
    $display("[%0t] Configurando modo STEP...", $time);
    write_register(8'h04, 32'h0002);  // step_mode = 1

    // Leer configuración de control
    read_register(8'h04, reg_rd_data);
    $display("[%0t] CONTROL register: 0x%08h (step_mode=%b)", $time, reg_rd_data, reg_rd_data[1]);

    // ===== TEST 9: Verificación de status final =====
    $display("\n=== TEST 9: Estado final ===");
    read_register(8'h05, reg_rd_data);
    $display("[%0t] Final STATUS: 0x%08h", $time, reg_rd_data);
    $display("[%0t]   Ready=%b, Busy=%b, Error=%b", $time, reg_rd_data[0], reg_rd_data[1], reg_rd_data[2]);

    // ===== Resumen final =====
    $display("\n========================================");
    $display("Testbench completado");
    $display("========================================");
    
    #(10 * CLK_PERIOD);
    $finish;
  end

  // =====================================================================
  // Monitor de señales (opcional)
  // =====================================================================
  initial begin
    $monitor("[%0t] CLK=%b RST=%b READY=%b BUSY=%b ERROR=%b",
      $time, clk, rst_n, ready, busy, error);
  end

  // =====================================================================
  // Dumping de waveforms (para visualización con GTKWave)
  // =====================================================================
  initial begin
    $dumpfile("tb_downscaler.vcd");
    $dumpvars(0, tb_top_downscaler_simd);
  end

endmodule
